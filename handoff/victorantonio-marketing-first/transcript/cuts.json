   "no_refine": true
  },
  {
   "clip": "A_JBRthrFB4_004755-005210.mkv",
   "start": 42.5,
   "end": 43.166666666666664,
   "transcript": "We have two kids.",
   "no_refine": true
  },
  {
   "clip": "A_JBRthrFB4_004755-005210.mkv",
   "start": 43.5,
   "end": 44.4,
   "transcript": "We got debt.",
