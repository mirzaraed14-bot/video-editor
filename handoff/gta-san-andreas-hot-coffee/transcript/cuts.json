   "clip": "hot-coffee-synced.mp4",
   "start": 205.9057,
   "end": 208.875333,
   "transcript": "listing the explicit content he wants in the game."
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 217.1169,
   "end": 218.651767,
   "transcript": "Colby writes back with a warning."
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 220.904017,
