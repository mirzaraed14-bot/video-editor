   "end": 535.28475,
   "transcript": "they find a few"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 539.972767,
   "end": 542.325117,
   "transcript": "whose names don't correspond to anything"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 544.9444,
   "end": 546.9464,
   "transcript": "in the game anyone has played"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 549.765883,
   "end": 551.284067,
   "transcript": "one is called sex"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 551.734517,
   "end": 553.019133,
   "transcript": "one is called kissing"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 553.6531,
   "end": 555.70515,
   "transcript": "one is called snm"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 558.074183,
   "end": 561.4609,
   "transcript": "and one is a word i'm not going to say on this channel"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 567.333433,
   "end": 570.052817,
   "transcript": "A model going by the name Barton Waterduck"
