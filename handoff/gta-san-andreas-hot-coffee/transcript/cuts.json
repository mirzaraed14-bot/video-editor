  {
   "clip": "hot-coffee-synced.mp4",
   "start": 243.159583,
   "end": 244.761183,
   "transcript": "Console manufacturers"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 245.028117,
   "end": 245.962383,
   "transcript": "refused"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 247.513933,
   "end": 249.616033,
   "transcript": "license adult only games"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 252.1519,
   "end": 254.070483,
   "transcript": "Walmart refused to stock them"
