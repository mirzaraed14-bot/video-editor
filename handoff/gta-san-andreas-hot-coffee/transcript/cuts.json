   "clip": "hot-coffee-synced.mp4",
   "start": 493.2928,
   "end": 495.011183,
   "transcript": "somebody had already found it."
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 503.15265,
   "end": 507.2067,
   "transcript": "December 2004 The PlayStation 2 version has been out for two months,"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 507.4069,
   "end": 509.1086,
   "transcript": "and a small group of modders"
