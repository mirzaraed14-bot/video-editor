   "clip": "hot-coffee-synced.mp4",
   "start": 515.097917,
   "end": 516.999817,
   "transcript": "console games are too hard to alter"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 517.633783,
   "end": 518.434583,
   "transcript": "they're reading"
  },
