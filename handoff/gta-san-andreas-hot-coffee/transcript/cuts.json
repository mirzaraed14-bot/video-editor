   "transcript": ""
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 168.651817,
   "end": 169.886383,
   "transcript": "Not who unlocked it."
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 171.688183,
   "end": 173.506667,
   "transcript": "Why was it there at all?"
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 188.404883,
   "end": 189.606083,
   "transcript": "Eleven months earlier,"
