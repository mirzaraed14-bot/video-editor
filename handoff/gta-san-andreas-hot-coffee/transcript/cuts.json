  {
   "clip": "hot-coffee-synced.mp4",
   "start": 280.463517,
   "end": 283.516567,
   "transcript": "Rockstar starts mapping exactly where the line sits."
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 283.766817,
   "end": 286.819867,
   "transcript": "On the 16th of August, co-founder Terry"
  },
