   "end": 195.34515,
   "transcript": "2004, San Andreas is three months from release."
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 195.678817,
   "end": 200.066533,
   "transcript": "Sam Houser, president of Rockstar Games, sends an email to Jennifer Colby,"
  },
  {
   "clip": "hot-coffee-synced.mp4",
