   "clip": "hot-coffee-synced.mp4",
   "start": 350.60025,
   "end": 351.267583,
   "transcript": "Finished."
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 351.267583,
   "end": 351.584567,
   "transcript": ""
  },
  {
   "clip": "hot-coffee-synced.mp4",
   "start": 351.584567,
   "end": 353.10275,
   "transcript": "Sitting on the disc."
