  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 485.91876666666667,
   "end": 486.7529333333333,
   "transcript": "for decades",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 490.85703333333333,
   "end": 493.45963333333333,
   "transcript": "describes what being signed actually means.",
