   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 428.6282,
   "end": 431.1974333333333,
   "transcript": "Rockstar didn't go shopping for songs, right?",
