  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 432.78235,
   "end": 433.8334,
   "transcript": "They picked people",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 437.75398333333334,
   "end": 439.9395,
   "transcript": "and gave each one a place to belong.",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 449.5324166666667,
   "end": 451.86808333333335,
   "transcript": "film casting actors into the scenes, right?",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 457.40695,
   "end": 458.5914666666667,
   "transcript": "So Travis says yes.",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 458.92513333333335,
   "end": 460.24311666666665,
   "transcript": "His manager says yes.",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 460.5601,
   "end": 461.51105,
   "transcript": "Everything is done, right?",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 463.83003333333335,
   "end": 464.53073333333333,
   "transcript": "No.",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 468.23443333333336,
   "end": 471.4042666666667,
   "transcript": "Because Travis Scott is signed to a record company called Epic.",
   "no_refine": true,
   "from": "creator hand cut 2026-09-19"
  },
  {
   "clip": "gta6-travis-scott-synced.mov",
   "start": 477.12665,
   "end": 479.81266666666664,
   "transcript": "and here's how someone who's actually worked in this industry",
