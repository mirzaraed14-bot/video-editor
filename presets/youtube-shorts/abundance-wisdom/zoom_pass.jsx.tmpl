// Abundance Wisdom zoom pass (generated by zoom_pass.py). Re-runnable, one undo group.
// Reads apply.tsv: id, start, end, dir, z0, z1, centerX, centerY
(function () {
    var OUT = "%OUT%";
    var L = [];
    function n(v) { return Math.round(v * 1000) / 1000; }
    try {
        var NAME = "%COMP%", LAYER_NAME = "%LAYER%";
        var DEP_MULT = 44.0, DEP_INFL = 1.7, ARR_MULT = 17.0, ARR_INFL = 2.8;   // the house curve

        var f = new File("%TSV%");
        f.open("r"); var txt = f.read(); f.close();
        var lines = txt.split("\n");

        var comp = null;
        for (var i = 1; i <= app.project.numItems; i++) {
            var it = app.project.item(i);
            if (it instanceof CompItem && it.name === NAME) comp = it;
        }
        if (!comp) { L.push("COMP NOT FOUND " + NAME); }
        else {
            app.beginUndoGroup("Abundance Wisdom zoom pass (Claude)");
            var removed = 0;
            for (var d = comp.numLayers; d >= 1; d--) {
                if (comp.layer(d).name === LAYER_NAME && comp.layer(d).adjustmentLayer) { comp.layer(d).remove(); removed++; }
            }
            L.push("removed " + removed + " previous zoom layer(s)");
            // captions never zoom: zoom layers go directly UNDER a caption layer if there is one
            var cap = null;
            for (var c = 1; c <= comp.numLayers; c++) {
                var nm = comp.layer(c).name;
                // the glow bars are "White Solid 3 Comp 1" precomps: never a caption; zooms go ABOVE them
                if (/white solid/i.test(nm)) continue;
                if (nm.indexOf("Comp 1") >= 0 || /caption/i.test(nm)) { cap = comp.layer(c); break; }
            }
            for (var li = 0; li < lines.length; li++) {
                var row = lines[li].replace("\r", "");
                if (!row) continue;
                var p = row.split("\t");
                var start = parseFloat(p[1]), end = parseFloat(p[2]), dir = p[3];
                var z0 = parseFloat(p[4]), z1 = parseFloat(p[5]);
                var cx = parseFloat(p[6]), cy = parseFloat(p[7]);

                var lay = comp.layers.addSolid([1, 1, 1], LAYER_NAME, comp.width, comp.height, 1, comp.duration);
                lay.adjustmentLayer = true;
                lay.name = LAYER_NAME;
                if (cap && lay.index !== cap.index + 1) lay.moveAfter(cap);
                lay.startTime = 0;
                lay.inPoint = start;
                lay.outPoint = end;

                var ef = lay.property("Effects").addProperty("S_BlurMoCurves");
                ef.property("Center XY").setValue([cx, cy]);
                var z = ef.property("Z Dist");
                z.setValueAtTime(start, z0);
                z.setValueAtTime(end, z1);
                z.setInterpolationTypeAtKey(1, KeyframeInterpolationType.BEZIER, KeyframeInterpolationType.BEZIER);
                z.setInterpolationTypeAtKey(2, KeyframeInterpolationType.BEZIER, KeyframeInterpolationType.BEZIER);
                var rate = Math.abs(z1 - z0) / (end - start);
                var sign = (z1 > z0) ? 1 : -1;
                z.setTemporalEaseAtKey(1, [new KeyframeEase(0, 0.1)], [new KeyframeEase(sign * rate * DEP_MULT, DEP_INFL)]);
                z.setTemporalEaseAtKey(2, [new KeyframeEase(sign * rate * ARR_MULT, ARR_INFL)], [new KeyframeEase(0, 0.1)]);

                L.push(dir.toUpperCase() + "  " + p[0] + "  " + n(start) + "-" + n(end) +
                       "  Z " + z0 + " -> " + z1 + "  centre [" + cx + "," + cy + "]" +
                       (cy === 960 ? "" : "  <- face pivot") +
                       "  | read back: " + n(z.valueAtTime(start, false)) + " / " + n(z.valueAtTime((start + end) / 2, false)) +
                       " / " + n(z.valueAtTime(end - 0.0001, false)));
            }
            var used = {};
            for (var q = 1; q <= comp.numLayers; q++) { try { if (comp.layer(q).source) used[comp.layer(q).source.id] = true; } catch (e) {} }
            var solids = 0;
            for (var pi = app.project.numItems; pi >= 1; pi--) {
                var item = app.project.item(pi);
                if (item instanceof FootageItem && item.name === LAYER_NAME && !used[item.id] && item.usedIn.length === 0) { item.remove(); solids++; }
            }
            L.push("tidied " + solids + " unused solid item(s); comp has " + comp.numLayers + " layers");
            app.endUndoGroup();
        }
    } catch (err) {
        L.push("ERROR " + err.toString() + (err.line ? " line " + err.line : ""));
        try { app.endUndoGroup(); } catch (e2) {}
    }
    var o = new File(OUT); o.encoding = "UTF-8"; o.open("w"); o.write(L.join("\n")); o.close();
})();
