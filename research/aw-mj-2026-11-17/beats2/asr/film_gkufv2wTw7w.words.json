"segments": [
{
"start": 10.56,
"end": 12.36,
"text": " Michael, you're doing it again."
},
{
"start": 12.48,
"end": 13.76,
"text": "Take a step closer to the microphone."
},
{
"start": 13.82,
"end": 14.14,
"text": "That's it."
},
{
"start": 14.34,
"end": 15.72,
"text": "And I'm gonna need you to keep your feet still."
},
{
"start": 15.74,
"end": 16.74,
"text": "You understand me?"
},
{
"start": 17.12,
"end": 18.2,
"text": "Give me the same lead."
},
{
"start": 18.24,
"end": 23.0,
"text": "Here we go."
},
{
"start": 23.42,
"end": 26.82,
"text": "Let me talk to him."
},
{
"start": 26.98,
"end": 27.86,
"text": "No, he's just getting it."
},
{
"start": 27.98,
"end": 28.95,
"text": "I just need five minutes."
},
{
"start": 29.07,
"end": 31.73,
"text": "See, Joseph, won't you worry about keeping the borders on schedule, hmm?"
},
{
"start": 32.83,
"end": 33.73,
"text": "We got this over here."
},
{
"start": 37.19,
"end": 39.71,
"text": " Let me tell you something, son."
},
{
"start": 40.01,
"end": 41.39,
"text": "I've been doing this a long time."
},
{
"start": 41.53,
"end": 43.17,
"text": "I've never heard a voice quite like yours."
},
{
"start": 43.19,
"end": 44.03,
"text": "It's special."
},
{
"start": 44.19,
"end": 45.08,
"text": "You have something to say."
},
{
"start": 45.09,
"end": 45.94,
"text": "That's rare, Michael."
},
{
"start": 46.44,
"end": 47.36,
"text": "Yeah, this is a fader."
},
{
"start": 47.38,
"end": 48.34,
"text": "Come on, try it."
},
{
"start": 48.46,
"end": 49.0,
"text": "Excuse me."
},
{
"start": 49.32,
"end": 49.96,
"text": "Time to go, Michael."
},
{
"start": 50.14,
"end": 51.28,
"text": "Mr. Gordy's a very busy man."
},
{
"start": 51.32,
"end": 52.6,
"text": "I'm sure you've taken up enough of his time."
},
{
"start": 52.68,
"end": 54.98,
"text": "I can show you this stuff some other time, right?"
},
{
"start": 55.0,
"end": 55.96,
"text": "Okay, Mr. Gordy."
},
{
"start": 56.0,
"end": 56.4,
"text": "Thank you."
},
{
"start": 56.64,
"end": 59.81,
"text": "Now, Michael, ask me anything, anytime you want."
}
]
