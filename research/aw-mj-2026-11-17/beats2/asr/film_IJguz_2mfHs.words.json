"segments": [
{
"start": 1.96,
"end": 3.06,
"text": " This is my favorite page."
},
{
"start": 3.13,
"end": 4.02,
"text": "It's a peter pan."
},
{
"start": 5.04,
"end": 11.68,
"text": "And a shadow."
},
{
"start": 23.58,
"end": 27.14,
"text": "So, Michael, surgeries."
},
{
"start": 27.16,
"end": 29.24,
"text": "Have you had any surgeries in the past five years?"
},
{
"start": 32.68,
"end": 33.8,
"text": " What about medications?"
},
{
"start": 33.92,
"end": 34.62,
"text": "Are you taking any?"
},
{
"start": 35.19,
"end": 35.59,
"text": "No, ma'am."
},
{
"start": 37.13,
"end": 38.91,
"text": "Just vinegar and cream for my ventiligo."
},
{
"start": 40.31,
"end": 41.03,
"text": "Oh, I'm sorry."
},
{
"start": 42.03,
"end": 44.23,
"text": "You know, it's much more common than people think."
},
{
"start": 45.51,
"end": 46.31,
"text": "Has it spread?"
},
{
"start": 47.89,
"end": 48.89,
"text": "A little bit, yeah."
},
{
"start": 49.31,
"end": 52.72,
"text": "Yeah, but you know, the cream, it helps even up my skin tone."
},
{
"start": 53.2,
"end": 53.82,
"text": "Oh, I see."
},
{
"start": 53.84,
"end": 54.02,
"text": "Yeah."
},
{
"start": 54.44,
"end": 56.2,
"text": "Michael, good to see you again."
},
{
"start": 57.02,
"end": 57.9,
"text": "We're almost ready for you."
},
{
"start": 57.94,
"end": 59.38,
"text": "Any, uh, any last questions?"
},
{
"start": 59.88,
"end": 60.22,
"text": "Oh, no."
},
{
"start": 60.54,
"end": 60.94,
"text": "I'm ready."
},
{
"start": 61.53,
"end": 63.55,
"text": " I need to make a few marks around the nose."
},
{
"start": 67.67,
"end": 69.66,
"text": "You know, you're a pretty good looking kid."
},
{
"start": 70.48,
"end": 71.26,
"text": "You sure you want to do this?"
},
{
"start": 72.68,
"end": 74.8,
"text": "I'm not a kid anymore."
},
{
"start": 74.82,
"end": 76.44,
"text": "My nose is too big."
},
{
"start": 77.54,
"end": 78.44,
"text": "Not sure that's true."
},
{
"start": 80.14,
"end": 83.76,
"text": "You see, my face isn't symmetrical for the photographs and all."
},
{
"start": 85.81,
"end": 86.79,
"text": "I have to be perfect."
},
{
"start": 88.65,
"end": 89.19,
"text": "You're the boss."
},
{
"start": 90.73,
"end": 91.13,
"text": "Just relax."
},
{
"start": 127.02,
"end": 130.22,
"text": " Hey, what's going on, son?"
},
{
"start": 132.86,
"end": 133.14,
"text": "Son?"
},
{
"start": 136.24,
"end": 136.54,
"text": "Michael."
},
{
"start": 142.06,
"end": 143.84,
"text": "Boy, come here."
},
{
"start": 153.82,
"end": 156.12,
"text": "What in the world?"
},
{
"start": 159.85,
"end": 161.17,
"text": " Let me see something."
},
{
"start": 161.19,
"end": 170.02,
"text": "Hey."
},
{
"start": 170.06,
"end": 170.74,
"text": "Oh my God."
},
{
"start": 173.72,
"end": 174.1,
"text": "Michael."
},
{
"start": 175.92,
"end": 177.02,
"text": "It's from my sinuses."
},
{
"start": 243.22,
"end": 244.6,
"text": " Maybe I should get a nose job."
},
{
"start": 247.92,
"end": 248.52,
"text": "You think so?"
},
{
"start": 248.68,
"end": 249.52,
"text": "Yes, I do."
},
{
"start": 251.21,
"end": 252.77,
"text": "Muscle says everybody does it."
},
{
"start": 253.43,
"end": 255.99,
"text": "All the big stars, all our favorite ones."
},
{
"start": 257.43,
"end": 258.29,
"text": "Well, it looks great."
},
{
"start": 259.87,
"end": 260.57,
"text": "You really think so?"
},
{
"start": 260.67,
"end": 261.03,
"text": "I do."
},
{
"start": 261.05,
"end": 264.56,
"text": "See, I want a new look."
},
{
"start": 264.74,
"end": 266.82,
"text": "I'm going to reinvent myself."
},
{
"start": 267.93,
"end": 273.79,
"text": " You know, now that I'm doing my own thing, I want the world to see me differently."
},
{
"start": 275.47,
"end": 277.51,
"text": "Not a boy in a kid band anymore."
},
{
"start": 280.17,
"end": 281.29,
"text": "Look around, Michael."
},
{
"start": 281.31,
"end": 282.41,
"text": "Your fans love you."
},
{
"start": 284.59,
"end": 285.53,
"text": "They're not my fans."
},
{
"start": 286.3,
"end": 287.31,
"text": "They're part of my family."
},
{
"start": 289.7,
"end": 294.0,
"text": "It's just time for me to start taking control of my own destiny."
},
{
"start": 296.35,
"end": 298.57,
"text": " No, I want to be who I want to be."
},
{
"start": 299.09,
"end": 301.23,
"text": "Thank you for clicking on our video everybody."
},
{
"start": 301.51,
"end": 306.79,
"text": "If you like what you saw here make sure you like the video and subscribe and share with your friends who like this sort of content."
},
{
"start": 307.19,
"end": 310.13,
"text": "We're an independent company and we appreciate all of your support."
}
]
