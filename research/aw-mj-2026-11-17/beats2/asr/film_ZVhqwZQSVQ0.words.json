"segments": [
{
"start": 3.93,
"end": 5.09,
"text": " I need to talk to you."
},
{
"start": 5.25,
"end": 6.47,
"text": "I'm his father, Joseph Jackson."
},
{
"start": 6.7,
"end": 7.68,
"text": "This is Mother Catherine."
},
{
"start": 8.0,
"end": 9.62,
"text": "Hi, it's good to meet you."
},
{
"start": 9.64,
"end": 10.2,
"text": "Thank you."
},
{
"start": 11.06,
"end": 13.32,
"text": "Well, your son is in stable condition."
},
{
"start": 13.72,
"end": 14.4,
"text": "All right."
},
{
"start": 15.16,
"end": 16.12,
"text": "OK, when will he recover?"
},
{
"start": 16.34,
"end": 17.39,
"text": "It's too soon to tell."
},
{
"start": 17.57,
"end": 18.69,
"text": "It's going to be a long road."
},
{
"start": 19.59,
"end": 22.29,
"text": "He has third degree burns and substantial nerve damage."
},
{
"start": 23.11,
"end": 24.53,
"text": "Oh, do you think he'll ever be there?"
},
{
"start": 25.34,
"end": 27.12,
"text": " able to perform again, ever."
},
{
"start": 27.9,
"end": 28.34,
"text": "Joseph."
},
{
"start": 29.3,
"end": 32.4,
"text": "Mr. Jackson, your son almost died."
},
{
"start": 32.6,
"end": 33.06,
"text": "I know that."
},
{
"start": 33.22,
"end": 38.36,
"text": "Well, if that fire had caught his clothes or burned over to his face and eyes, he wouldn't be here."
},
{
"start": 38.38,
"end": 38.98,
"text": "I know my part."
},
{
"start": 39.38,
"end": 42.26,
"text": "And the only thing that's going to heal him is by getting back on that stage."
},
{
"start": 42.52,
"end": 43.24,
"text": "That's where he lives."
},
{
"start": 43.7,
"end": 44.64,
"text": "I understand that, sir."
},
{
"start": 45.08,
"end": 45.26,
"text": "Do you?"
},
{
"start": 45.28,
"end": 46.3,
"text": "It's going to be a while."
},
{
"start": 46.42,
"end": 47.19,
"text": "Yes, I do."
},
{
"start": 47.48,
"end": 50.45,
"text": "But Mr. Jackson, he's going to need your support to get there."
},
{
"start": 50.79,
"end": 51.33,
"text": "I'm sorry."
}
]
