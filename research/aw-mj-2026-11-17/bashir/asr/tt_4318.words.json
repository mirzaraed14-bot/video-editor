{
"start": 4318.05,
"end": 4318.97,
"text": " It's a kind thing."
},
{
"start": 4319.85,
"end": 4324.19,
"text": "This comment about Michael's method of raising children was included on Bashir's special."
},
{
"start": 4325.57,
"end": 4328.83,
"text": "Your relationship with your children is spectacular."
},
{
"start": 4328.99,
"end": 4333.15,
"text": "And in fact, it almost makes me weep when I see you with them."
},
{
"start": 4333.41,
"end": 4337.73,
"text": "Another of Jackson's complaints about the documentary"
}
]
