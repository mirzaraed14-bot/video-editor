"segments": [
{
"start": 2185.05,
"end": 2191.32,
"text": " during Bashir's final interview with Michael long after the incident with the baby on the Berlin hotel balcony."
},
{
"start": 2193.42,
"end": 2198.3,
"text": "One of the things that I noticed about you over the last year is your relationship with your children."
},
{
"start": 2198.66,
"end": 2205.99,
"text": "And I have to say to you, and I didn't know you before, and you haven't put on a front, your relationship with your children is spectacular."
},
{
"start": 2206.67,
"end": 2207.8,
"text": "I love you."
},
{
"start": 2208.64,
"end": 2218.01,
"text": " And in fact, it almost makes me weep when I see you with them, because your interaction with them is just so natural, so loving, so caring."
},
{
"start": 2218.15,
"end": 2218.81,
"text": "Thank you so much."
},
{
"start": 2219.29,
"end": 2223.31,
"text": "And everybody, whoever comes into contact with you, knows that."
},
{
"start": 2224.25,
"end": 2224.85,
"text": "I'm creative."
}
]
